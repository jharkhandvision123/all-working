<body>

<div class="container">

    <div class="card">

        <h1>Passport Photo System</h1>

        <div
            class="upload-area"
            id="pasteArea"
            tabindex="0"
        >
            <h3>Photo यहाँ Paste करें</h3>

            <p>
                <b>Ctrl + V</b> दबाकर फोटो Paste करें
            </p>

