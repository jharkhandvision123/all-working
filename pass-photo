                </label>

                <label class="file-label" for="pdfInput">
                    📄 PDF Upload
                </label>

            </div>
        </div>

        <input
            type="file"
            id="fileInput"
            accept="image/*"
        >

        <input
            type="file"
            id="pdfInput"
            accept="application/pdf"
        >

        <div class="pdf-box" id="pdfBox">
            PDF चुना गया है।
            <br>
            <span id="pdfName"></span>
            <br><br>
            <small>
                PDF processing अगले चरण में जोड़ा जाएगा।
            </small>
        </div>

        <div class="preview-section" id="previewSection">

            <h2>Crop करें</h2>

            <div class="image-wrapper">
                <img id="previewImage" alt="Preview">
            </div>

            <div class="crop-actions">

                <button
                    class="crop-btn"
                    id="cropButton"
                    type="button"
                >
                    ✂️ Crop करें
                </button>

